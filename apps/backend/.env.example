# Database (Local Docker PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vakiloncall

# Redis (Local Docker Redis)
REDIS_URL=redis://localhost:6379

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Exotel
EXOTEL_SID=your-exotel-sid
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_CALLER_ID=your-exotel-caller-id

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this

# Server
PORT=3000
NODE_ENV=development

# Sentry
SENTRY_DSN=

# Dev auth (development only — OTP always 123456)
DEV_AUTH_OTP=123456
